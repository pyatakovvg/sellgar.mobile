{
  "name": "root",
  "license": "UNLICENSED",
  "scripts": {
    "update": "yarn upgrade-interactive",
    "format": "prettier --write \"**/src/**/*.{ts,tsx}\" \"**/test/**/*.ts\" \"**/prisma/**/*.ts\"",
    "lint": "eslint \"**/{src,test}/**/*.{ts,tsx}\" --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "clients/*",
    "helpers/*",
    "library/*",
    "screens/*",
    "utils/*",
    "widgets/*",
    "layouts/*"
  ],
  "engines": {
    "node": "^22"
  },
  "packageManager": "yarn@4.18.0"
}
